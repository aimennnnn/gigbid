     "description": "Unique key; reusing it returns the first result",
     "maxLength": 128,
     "minLength": 8,
     "title": "Idempotency Key",
     "type": "string"
    },
    "subject": {
     "maxLength": 200,
     "minLength": 1,
     "title": "Subject",
     "type": "string"
    },
    "to": {
     "description": "Recipient email address",
     "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
