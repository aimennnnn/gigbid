{
 "marketplace.create_proposal_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "description": "Save a proposal as a DRAFT on the marketplace. Spends no Connects and sends nothing to the client.",
  "input": {
   "properties": {
    "amount": {
     "description": "Bid in USD",
     "exclusiveMinimum": 0,
     "maximum": 1000000,
     "title": "Amount",
     "type": "number"
    },
    "cover_letter": {
     "maxLength": 5000,
     "minLength": 50,
     "title": "Cover Letter",
     "type": "string"
    },
    "dry_run": {
     "default": false,
     "description": "If true, nothing is sent: returns exactly what would be sent and what it costs.",
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "description": "Unique key for this write. Reusing a key returns the first result and does nothing new.",
     "maxLength": 128,
     "minLength": 8,
     "title": "Idempotency Key",
     "type": "string"
    },
    "job_id": {
     "description": "Marketplace job id, e.g. 'dev-ml-004'",
     "maxLength": 64,
     "minLength": 1,
     "title": "Job Id",
     "type": "string"
    },
    "screening_answers": {
     "additionalProperties": {
      "type": "string"
     },
     "default": {},
     "description": "Screening question -> answer",
     "title": "Screening Answers",
     "type": "object"
    }
   },
   "required": [
    "job_id",
    "cover_letter",
    "amount",
    "idempotency_key"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "connects_balance_after": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Connects Balance After"
    },
    "connects_cost": {
     "default": 0,
     "title": "Connects Cost",
     "type": "integer"
    },
    "dry_run": {
     "title": "Dry Run",
     "type": "boolean"
    },
    "id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Draft id, proposal id or thread id",
     "title": "Id"
    },
    "replayed": {
     "default": false,
     "description": "True if this idempotency key was already used",
     "title": "Replayed",
     "type": "boolean"
    },
    "status": {
     "description": "'preview' for a dry run, otherwise the marketplace status",
     "title": "Status",
     "type": "string"
    },
    "would_send": {
     "additionalProperties": true,
     "description": "Exactly what is (or would be) sent to the marketplace",
     "title": "Would Send",
     "type": "object"
    }
   },
   "required": [
    "dry_run",
    "status",
    "would_send"
   ],
   "title": "WriteResult",
   "type": "object"
  }
 },
