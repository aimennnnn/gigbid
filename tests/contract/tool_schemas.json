   "type": "object"
  },
  "output": {
   "properties": {
    "body": {
     "title": "Body",
     "type": "string"
    },
    "draft_id": {
     "title": "Draft Id",
     "type": "string"
    },
    "replayed": {
     "default": false,
     "title": "Replayed",
     "type": "boolean"
    },
    "status": {
     "default": "draft",
     "title": "Status",
     "type": "string"
    },
    "subject": {
     "title": "Subject",
     "type": "string"
    },
    "to": {
     "title": "To",
