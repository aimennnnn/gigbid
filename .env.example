# Copy to .env and fill in. Never commit .env.
GIGBID_PROFILE=open            # open | paid
GIGBID_MARKETPLACE=gigsim      # gigsim | upwork
GROQ_API_KEY=
ANTHROPIC_API_KEY=             # only for the optional paid profile
GIGSIM_URL=http://gigsim:8081
GIGSIM_ERROR_RATE=0.03          # how often GigSim fails on purpose
MCP_TOKENS=change-me:reviewer   # token:user pairs for the MCP servers
DATABASE_URL=postgresql://gigbid:gigbid@postgres:5432/gigbid
REDIS_URL=redis://redis:6379/0
TOKEN_ENCRYPTION_KEY=          # encrypts stored OAuth tokens
JWT_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
GITHUB_TOKEN=                  # for the GitHub MCP server (repo ingestion)
